; DEEP - GO DEEPER. FIND LIFE.
; Engine configuration file.

config_version=5

[application]

config/name="DEEP"
config/description="GO DEEPER. FIND LIFE. — 2D subterranean exploration / excavation / creature codex."
config/version="0.1.0"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.svg"
boot_splash/bg_color=Color(0.03, 0.035, 0.05, 1)
boot_splash/show_image=false

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
Audio="*res://scripts/core/audio_service.gd"
SaveManager="*res://scripts/save/save_manager.gd"
Game="*res://scripts/core/game_state.gd"
Dbg="*res://scripts/core/debug_service.gd"
Router="*res://scripts/core/scene_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

